            "qf": 0.005,
            "rv_floor": 0.05,
            "tau_env": 32
          }
        }
      },
      {
        "name": "profile1d_cubic__robust_ossm_ekf",
        "params": {
          "oscillator": {
            "predict_method": "ekf",
            "student_t_nu": 15.0,
            "vb_iters": 3,
            "trace_cap": 50.0,
            "eda_baseline": false,
            "qx": 0.005,
            "qf": 0.005,
            "rv_floor": 0.05,
            "tau_env": 32
          }
        }
      },
      {
        "name": "profile1d_cubic__robust_ossm_ukf",
        "params": {
          "oscillator": {
            "predict_method": "ukf",
            "student_t_nu": 15.0,
            "vb_iters": 3,
            "trace_cap": 50.0,
            "eda_baseline": false,
            "qx": 0.005,
            "qf": 0.005,
            "rv_floor": 0.05,
            "tau_env": 32
          }
        }
      }
    ],
    "eval": {
      "win_size": 30,
      "stride": 1,
      "min_hz": 0.08,
      "max_hz": 0.5,
      "use_track": true,
      "track_std_min_bpm": 0.8,
      "track_unique_min": 0.05,
      "track_saturation_max": 0.35
    },
    "oscillator": {
      "f_min": 0.08,
      "f_max": 0.5,
      "em_mode": "online",
      "qx": 0.005,
      "qf": 0.005,
      "rv_floor": 0.05,
      "post_smooth_alpha": 0.9,
      "spec_guidance_strength": 1.0,
      "spec_guidance_offset": 0.02,
      "tau_env": 32
    },
    "preproc": {
      "robust_zscore": {
        "enabled": true,
        "eps": 1e-06,
        "clip": 2.5
      }
    },
    "quality": {
      "vis_snr_low_db": -5.0,
      "vis_snr_high_db": 5.0,
      "vis_blend_contrast": 0.2,
      "vis_blend_snr": 0.5,
      "vis_blend_valid": 0.3,
      "drift_scale": 0.25,
      "burst_sigma": 3.0
    },
    "trust": {
      "beta_1": 2.0,
      "beta_2": 1.5,
      "gamma_1": 1.0,
      "w_gate_vis": 2.0,
      "w_gate_cons": 1.5,
      "w_gate_nis": 0.5,
      "gate_bias": 1.0,
      "freq_jitter_decay": 0.8,
      "thd_max": 0.3,
      "nis_hard_gate": 15.0,
      "alpha_R_max": 20.0,
      "alpha_Q_max": 5.0
    },
    "gating": {
      "profile": "paper",
      "tracker": {
        "std_min_bpm": 0.8,
        "unique_min": 0.05,
        "saturation_max": 0.35,
        "std_is_soft": true
      },
      "spectral": {
        "peak_ratio_min": 1.2,
        "prominence_min_db": 3.0,
        "fwhm_max_hz": 0.6,
        "fwhm_df_guard": 0.05
      },
      "debug": {
        "disable_gating": false
      }
    },
    "report": {
      "output": "reports/cohface_robust_ossm",
      "unique_window": false
    },
    "runtime": {
      "device": "cpu"
    },
    "steps": [
      "estimate",
      "evaluate",
      "metrics",
      "eda",
      "visualize",
      "metadata"
    ]
  }
  
