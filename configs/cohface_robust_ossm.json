{
    "name": "cohface_robust_ossm",
    "results_dir": "results",
    "datasets": [
      {
        "name": "COHFACE",
        "roi": {
          "chest": {
            "mp_complexity": 1,
            "skip_rate": 10
          }
        }
      }
    ],
    "methods": [
      "of_farneback",
      "profile1d_quadratic",
      "profile1d_cubic",
      {
        "name": "of_farneback__kfstd",
        "params": {
            "em_mode": "online",
            "qx": 0.005,
            "qf": 0.005,
            "rv_floor": 0.05,
            "post_smooth_alpha": 0.9,
            "spec_guidance_strength": 1.0,
            "spec_guidance_offset": 0.02
          }
      },
      {
        "name": "profile1d_quadratic__kfstd",
        "params": {
          "oscillator": {
            "em_mode": "online",
            "qx": 0.005,
            "qf": 0.005,
            "rv_floor": 0.05,
            "post_smooth_alpha": 0.9,
            "spec_guidance_strength": 1.0,
            "spec_guidance_offset": 0.02
          }
        }
      },
      {
        "name": "profile1d_cubic__kfstd",
        "params": {
          "oscillator": {
            "em_mode": "online",
            "qx": 0.005,
            "qf": 0.005,
            "rv_floor": 0.05,
            "post_smooth_alpha": 0.9,
            "spec_guidance_strength": 1.0,
            "spec_guidance_offset": 0.02
          }
        }
      },
      {
        "name": "of_farneback__robust_ossm_ekf",
        "params": {
          "oscillator": {
            "predict_method": "ekf",
            "student_t_nu": 15.0,
            "vb_iters": 3,
            "trace_cap": 50.0,
            "eda_baseline": false,
            "qx": 0.005,
            "qf": 0.005,
            "rv_floor": 0.05,
            "tau_env": 32
          }
        }
      },
      {
        "name": "of_farneback__robust_ossm_ukf",
        "params": {
          "oscillator": {
            "predict_method": "ukf",
            "student_t_nu": 15.0,
            "vb_iters": 3,
            "trace_cap": 50.0,
            "eda_baseline": false,
            "qx": 0.005,
            "qf": 0.005,
            "rv_floor": 0.05,
            "tau_env": 32
          }
        }
      },
      {
        "name": "profile1d_linear"
      },
      {
        "name": "profile1d_linear__kfstd",
        "params": {
          "oscillator": {
            "em_mode": "online",
            "qx": 0.005,
            "qf": 0.005,
            "rv_floor": 0.05
          }
        }
