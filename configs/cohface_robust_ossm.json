            "rv_floor": 0.05,
            "tau_env": 32
          }
        }
      },
      {
        "name": "profile1d_linear__robust_ossm_ukf",
        "params": {
          "oscillator": {
            "predict_method": "ukf",
            "student_t_nu": 15.0,
            "qx": 0.005,
            "qf": 0.005,
            "rv_floor": 0.05,
            "tau_env": 32
          }
        }
      },
      {
        "name": "profile1d_quadratic__robust_ossm_ekf",
        "params": {
          "oscillator": {
            "predict_method": "ekf",
