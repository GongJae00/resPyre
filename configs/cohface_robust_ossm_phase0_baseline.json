{
  "name": "cohface_robust_ossm_phase0_baseline",
  "results_dir": "results",
  "datasets": [
    {
      "name": "COHFACE",
      "roi": {
        "chest": {
          "mp_complexity": 1,
          "skip_rate": 10
        }
      }
    }
  ],
  "methods": [
    {
      "name": "of_farneback__robust_ossm_ekf",
      "params": {
        "oscillator": {
          "predict_method": "ekf",
          "eda_baseline": true,
          "student_t_nu": 15.0,
          "qx": 0.005,
          "qf": 0.005,
          "rv_floor": 0.05,
          "tau_env": 32
        }
      }
    },
    {
      "name": "profile1d_quadratic__robust_ossm_ekf",
      "params": {
        "oscillator": {
          "predict_method": "ekf",
          "eda_baseline": true,
          "student_t_nu": 15.0,
          "qx": 0.005,
          "qf": 0.005,
          "rv_floor": 0.05,
          "tau_env": 32
        }
      }
    }
  ],
  "eval": {
    "win_size": 30,
    "stride": 1,
    "min_hz": 0.08,
    "max_hz": 0.5
  },
  "oscillator": {
    "f_min": 0.08,
    "f_max": 0.5,
    "tau_env": 32
  },
  "preproc": {
    "robust_zscore": {
      "enabled": true,
      "eps": 1e-06,
      "clip": 2.5
    }
  },
  "steps": [
    "estimate",
    "evaluate",
    "eda",
    "metadata"
  ]
}

