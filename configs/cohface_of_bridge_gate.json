{
    "name": "cohface_of_bridge_gate",
    "results_dir": "results/cohface_of_bridge_gate",
    "datasets": [
        {
            "name": "COHFACE",
            "roi": {
                "chest": {
                    "mp_complexity": 1,
                    "skip_rate": 10
                }
            }
        }
    ],
    "methods": [
        "of_farneback",
        "of_disp_bridge",
        {
            "name": "of_farneback__kfstd",
            "params": {
                "oscillator": {
                    "em_mode": "off",
                    "no_autotune": true,
                    "qx": 0.005,
                    "qf": 0.005,
                    "rv_floor": 0.05,
                    "post_smooth_alpha": 0.88,
                    "spec_guidance_strength": 1.0,
                    "spec_guidance_offset": 0.02
                }
            }
        },
        {
            "name": "of_disp_bridge__kfstd",
            "params": {
                "oscillator": {
                    "em_mode": "off",
                    "no_autotune": true,
                    "qx": 0.005,
                    "qf": 0.005,
                    "rv_floor": 0.05,
                    "post_smooth_alpha": 0.88,
                    "spec_guidance_strength": 1.0,
                    "spec_guidance_offset": 0.02
                }
            }
        },
        {
            "name": "of_farneback__parh_ossm",
            "params": {
                "oscillator": {
                    "no_autotune": true,
                    "em_mode": "off",
                    "rv_auto": false,
                    "rv_floor": 0.05,
                    "qx": 0.005,
                    "tau_env": 30.0,
                    "post_smooth_alpha": 0.88
                }
            }
        },
        {
            "name": "of_disp_bridge__parh_ossm",
            "params": {
                "oscillator": {
                    "no_autotune": true,
                    "em_mode": "off",
                    "rv_auto": false,
                    "rv_floor": 0.05,
                    "qx": 0.005,
                    "tau_env": 30.0,
                    "post_smooth_alpha": 0.88
                }
            }
        }
    ],
    "eval": {
        "win_size": 30,
        "stride": 1,
        "min_hz": 0.08,
        "max_hz": 0.5,
        "use_track": true,
        "track_std_min_bpm": 0.8,
        "track_unique_min": 0.05,
        "track_saturation_max": 0.35,
        "frame_log_strict": false,
        "allow_missing": true,
        "calibration": {
            "nis_dof": 1.0,
            "nis_alpha_strict": 0.05,
            "nis_inband_target": 0.95,
            "nis_mean_tol_relaxed": 0.35,
            "nis_inband_tol_relaxed": 0.18
        }
    },
    "oscillator": {
        "f_min": 0.08,
        "f_max": 0.5,
        "no_autotune": true,
        "em_mode": "off",
        "qx": 0.005,
        "rv_floor": 0.05,
        "rv_auto": false,
        "tau_env": 30.0,
        "post_smooth_alpha": 0.88
    },
    "preproc": {
        "robust_zscore": {
            "enabled": true,
            "eps": 1e-06,
            "clip": 5.0
        },
        "sign_align": {
            "enabled": true,
            "seconds": 10.0
        }
    },
    "gating": {
        "profile": "relaxed",
        "tracker": {
            "std_min_bpm": 0.55,
            "unique_min": 0.05,
            "saturation_max": 0.42,
            "std_is_soft": true,
            "saturation_margin_hz": 0.02
        },
        "spectral": {
            "peak_ratio_min": 1.25,
            "prominence_min_db": 1.5,
            "fwhm_max_hz": 0.55,
            "fwhm_df_guard": 1.5
        }
    },
    "runtime": {"device": "cpu"},
    "steps": ["estimate", "metrics", "metadata"]
}
