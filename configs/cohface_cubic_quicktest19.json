{
    "name": "cohface_cubic_quicktest19",
    "results_dir": "results",
    "datasets": [{"name": "COHFACE", "roi": {"chest": {"mp_complexity": 1, "skip_rate": 10}}}],
    "methods": [
        {
            "name": "profile1d_cubic__kfstd",
            "params": {"oscillator": {"em_mode": "off", "qx": 0.005, "qf": 0.005, "rv_floor": 0.05, "post_smooth_alpha": 0.9, "spec_guidance_strength": 1.0, "spec_guidance_offset": 0.02}}
        },
        {
            "name": "profile1d_cubic__robust_ossm_ekf",
            "gating_scope": "evaluation_only",
            "params": {
                "oscillator": {
                    "predict_method": "ekf", "use_eks": true, "eks_2d_rts": false,
                    "eks_freq_from_phase": false,
                    "eda_baseline": false, "no_autotune": true, "em_mode": "off",
                    "rv_auto": true, "rv_floor": 0.05, "rv_mad_scale": 1.0,
                    "qx": 0.005, "qf": 0.005, "tau_env": 52.0, "student_t_nu": 9999.0,
                    "g_z_eff_floor_ratio": 0.0, "post_smooth_alpha": 0.9,
                    "spec_guidance_strength": 1.0, "spec_guidance_offset": 0.02
                },
                "trust": {
                    "gate_bias": -100.0, "w_gate_nis": 0.0, "w_gate_vis": 0.0, "w_gate_cons": 0.0,
                    "alpha_R_max": 1.0, "beta_1": 0.0, "beta_2": 0.0, "gamma_1": 0.0,
                    "g_z_floor": 0.0, "freq_jitter_decay": 0.0, "w_h_min": 1.0, "thd_max": 9999.0
                }
            }
        }
    ],
    "eval": {
        "win_size": 30, "stride": 1, "min_hz": 0.08, "max_hz": 0.5,
        "use_track": true, "track_std_min_bpm": 0.8, "track_unique_min": 0.05,
        "track_saturation_max": 0.35, "frame_log_strict": false, "allow_missing": true,
        "calibration": {"nis_dof": 1.0, "nis_alpha_strict": 0.05, "nis_inband_target": 0.95, "nis_mean_tol_relaxed": 0.35, "nis_inband_tol_relaxed": 0.18}
    },
    "gating_scope": "filter_time",
    "oscillator": {
        "f_min": 0.08, "f_max": 0.5, "predict_method": "ekf", "no_autotune": true, "em_mode": "off",
        "qx": 0.00022, "qf": 5e-05, "rv_floor": 0.012, "rv_mad_scale": 0.9, "tau_env": 52.0,
        "student_t_nu": 12.0, "vb_iters": 2, "trace_cap": 120.0, "lambda_floor": 0.004,
        "r_eff_max_scale": 25.0, "g_z_eff_floor_ratio": 0.24, "post_smooth_alpha": 0.86,
        "spec_guidance_strength": 0.95, "spec_guidance_offset": 0.22
    },
    "preproc": {"robust_zscore": {"enabled": true, "eps": 1e-06, "clip": 2.5}, "sign_align": {"enabled": true, "seconds": 10.0}},
    "quality": {"vis_snr_low_db": -8.0, "vis_snr_high_db": 18.0, "vis_blend_contrast": 0.2, "vis_blend_snr": 0.5, "vis_blend_valid": 0.3, "drift_scale": 0.18, "cons_window": 40, "hampel_thresh": 2.8, "harm_window_sec": 6.0, "burst_sigma": 2.8},
    "trust": {"beta_1": 1.2, "beta_2": 0.85, "gamma_1": 1.9, "w_gate_vis": 1.6, "w_gate_cons": 1.3, "w_gate_nis": 0.45, "gate_bias": 0.72, "freq_jitter_decay": 0.62, "thd_max": 0.52, "w_h_min": 0.38, "g_z_floor": 0.2, "nis_hard_gate": 24.0, "alpha_R_max": 8.0, "alpha_Q_max": 3.2},
    "gating": {"profile": "relaxed", "tracker": {"std_min_bpm": 0.55, "unique_min": 0.05, "saturation_max": 0.42, "std_is_soft": true, "saturation_margin_hz": 0.02}, "spectral": {"peak_ratio_min": 1.25, "prominence_min_db": 1.5, "fwhm_max_hz": 0.55, "fwhm_df_guard": 1.5}, "debug": {"disable_gating": false}},
    "report": {"output": "reports/cohface_robust_ossm", "unique_window": false},
    "runtime": {"device": "cpu"},
    "steps": ["estimate", "metrics", "metadata"]
}
