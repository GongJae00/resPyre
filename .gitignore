# ============================================
# resPyre .gitignore — PARH-OSSM project
# ============================================

# --- Python bytecode / build ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
*.whl

# --- Environments ---
.venv/
.env
venv/
env/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- Claude Code ---
.claude/

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- LaTeX build artifacts (intermediate only) ---
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# --- Results (large data: PKL, NPZ, plots) ---
results/
**/obs_*.npy
**/obs_roi_stats_v1.npz

# --- Logs ---
*.log
!paper/*.tex

# --- Large reference PDFs ---
notes/공진자호흡논문_KCI.pdf

# --- Prompt scratch files ---
notes/prompts/

# --- OS files ---
.DS_Store
Thumbs.db
