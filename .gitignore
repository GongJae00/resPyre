# ============================================
# resPyre .gitignore — PARH-OSSM project
# ============================================

# --- Python bytecode / build ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
build/
dist/
*.whl

# --- Environments ---
.venv/
.env
venv/
env/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- Claude Code ---
.claude/

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- LaTeX build artifacts (intermediate only) ---
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
*.aux
*.blg
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
!paper/main.bbl

# --- Future generated-paper boundary ---
paper/
paper/generated/
paper/tmp/
analysis/tmp/
submission_package/
submission_support/

# --- Local manuscript/review notes ---
analysis/final_manual_review_checklist.md
analysis/final_operating_point_research_feedback.md
analysis/final_reviewer_risk_response.md
analysis/final_scientific_lessons.md
analysis/revision_response_summary.md

# --- Results (large data: PKL, NPZ, plots) ---
results/
results_*.zip
**/obs_*.npy
**/obs_roi_stats_v1.npz

# --- Local dataset links / raw data ---
dataset/*
!dataset/
!dataset/README_dataset.md
!dataset/*.tsv

# --- Logs ---
logs/
*.log
!paper/*.tex

# --- Large reference PDFs ---
paper/s41598-*.pdf
mainko.*
paper/main_ko.*
paper/figures/*_draft_source.png

# --- Prompt scratch files ---
goal.md
scripts/legacy/
analysis/legacy_*/
analysis/reconstructed_trial_priors/
analysis/final_priors/*_edges.csv
analysis/final_resource_profile.json
prompt*.md
feedbackprompt*.md
tmp_*.sh
.tmp_*/

# --- OS files ---
.DS_Store
Thumbs.db
